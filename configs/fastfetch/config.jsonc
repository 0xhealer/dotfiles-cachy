{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/logos/*.png",
    "type": "kitty",
    "height": 20,
    "padding": {
      "top": 1,
    },
  },
  "general": {
    "processingTimeout": 5000,
  },
  "display": {
    "separator": " ➜  ",
    "brightColor": true,
  },
  "modules": [
    {
      "type": "custom",
      "format": "                  {#magenta}안녕하세요, 힐러{#}                           ",
    },
    "break",
    "break",
    "break",
    {
      "type": "os",
      "key": "OS       ",
      "keyColor": "31",
    },
    {
      "type": "kernel",
      "key": " ├ 󰌽     ",
      "keyColor": "31",
    },
    {
      "type": "datetime",
      "key": " ├ 󰥔     ",
      "keyColor": "31",
      "format": "{year}-{month-pretty}-{day-pretty} {hour-pretty}:{minute-pretty}:{second-pretty} {timezone-name}",
    },
    {
      "type": "locale",
      "key": " └ 󰗊     ",
      "keyColor": "31",
    },
    "break",
    {
      "type": "memory",
      "key": "Hardware ",
      "keyColor": "32",
    },
    {
      "type": "swap",
      "key": " ├ 󰓡     ",
      "keyColor": "32",
    },
    {
      "type": "cpu",
      "key": " ├ 󰻠     ",
      "keyColor": "32",
      "showPeCoreCount": true,
    },
    {
      "type": "gpu",
      "key": " ├ 󰢮     ",
      "keyColor": "32",
      "gpuType": "discrete",
      "format": "{2}",
    },
    {
      "type": "disk",
      "key": " └ 󰋊     ",
      "keyColor": "32",
      "format": "{size-used} / {size-total} ({size-percentage}) - {filesystem}",
    },
    "break",
    {
      "type": "wm",
      "key": "Desktop  ",
      "keyColor": "33",
    },
    {
      "type": "de",
      "key": " ├ 󰧨     ",
      "keyColor": "33",
    },
    {
      "type": "theme",
      "key": " ├ 󰉼     ",
      "keyColor": "33",
    },
    {
      "type": "icons",
      "key": " ├ 󰀻     ",
      "keyColor": "33",
    },
    {
      "type": "display",
      "key": " ├ 󰍹     ",
      "keyColor": "33",
      "compactType": "original-with-refresh-rate",
    },
    {
      "type": "localip",
      "key": " ├ 󰩟     ",
      "keyColor": "33",
      "showIpv4": true,
      "showIpv6": false,
    },
    {
      "type": "media",
      "key": " ├ 󰎆     ",
      "keyColor": "33",
    },
    {
      "type": "player",
      "key": " └ 󰐊     ",
      "keyColor": "33",
    },
    "break",
    {
      "type": "shell",
      "key": "Terminal ",
      "keyColor": "34",
    },
    {
      "type": "terminal",
      "key": " ├      ",
      "keyColor": "34",
    },
    {
      "type": "packages",
      "key": " ├ 󰏖     ",
      "keyColor": "34",
      "winget": true,
    },
    {
      "type": "version",
      "key": " └ 󰓹     ",
      "keyColor": "34",
      "format": "v{version}",
    },
    "break",
    {
      "type": "uptime",
      "key": "Uptime   ",
      "keyColor": "36",
    },
    {
      "type": "disk",
      "keyIcon": "󰃭",
      "key": " └ 󰃭     ",
      "keyColor": "36",
      "folders": "/",
      "format": "{create-time:10} [{days} days]",
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
    },
  ],
}
